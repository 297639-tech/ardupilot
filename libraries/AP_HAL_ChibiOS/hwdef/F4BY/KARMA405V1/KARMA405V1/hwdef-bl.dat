# hwdef bootloader for KARMA405V1 (STM32F405, 1MB flash)
# DRAFT, based on MatekF405/hwdef-bl.dat

MCU STM32F4xx STM32F405xx
APJ_BOARD_ID 5001

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 64

SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG_FS
PA12 OTG_FS_DP OTG_FS
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LED polarity ??? check
PB0 LED_BOOTLOADER OUTPUT HIGH
define HAL_LED_ON 0

# hwdef for KARMA405V1 (STM32F405, Betaflight board_name KARMA405V1, manufacturer KRMA)
# DRAFT. Items marked ??? need checking.

MCU STM32F4xx STM32F405xx
APJ_BOARD_ID AP_HW_KARMA405V1
OSCILLATOR_HZ 8000000             # system_hse_mhz = 8
FLASH_SIZE_KB 1024

# Service lines, as in MatekF405/hwdef.dat
FLASH_RESERVE_START_KB 64
define HAL_STORAGE_SIZE 15360
STORAGE_FLASH_PAGE 1
# system tick on TIM5, because TIM2 is used by PB10 PWM output
define STM32_ST_USE_TIMER 5
#define HAL_BARO_ALLOW_INIT_NO_BARO

# F405 1MB: trim features to fit in flash
include ../include/minimize_fpv_osd.inc

define HAL_NAVEKF2_AVAILABLE 0
define AP_SCRIPTING_ENABLED 0
define HAL_MOUNT_ENABLED 0
define HAL_PARACHUTE_ENABLED 0
define HAL_SPRAYER_ENABLED 0
define HAL_GENERATOR_ENABLED 0
define HAL_ADSB_ENABLED 0
define AP_OPTICALFLOW_ENABLED 0
define HAL_GYROFFT_ENABLED 0

# ---------------- USB / SWD ----------------
# No VBUS sense (PA9 is used by motor 4)
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ---------------- UART ----------------
PB6  USART1_TX USART1             # free port
PB7  USART1_RX USART1
PA2  USART2_TX USART2             # CRSF receiver
PA3  USART2_RX USART2
PC10 USART3_TX USART3             # MSP DisplayPort (HD OSD/VTX)
PC11 USART3_RX USART3
PA1  UART4_RX  UART4              # ESC telemetry (RX only)
PC12 UART5_TX  UART5              # free port
PD2  UART5_RX  UART5
PC6  USART6_TX USART6             # free port
PC7  USART6_RX USART6

# SERIAL0=USB, 1=USART1, 2=USART2, 3=USART3, 4=UART4, 5=UART5, 6=USART6
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6

# Parameters to set after first flash:
#   SERIAL2_PROTOCOL = 23 (RCIN, CRSF)
#   SERIAL3_PROTOCOL = 42 (MSP DisplayPort)
#   SERIAL4_PROTOCOL = 16 (ESC Telemetry)

# ---------------- SPI ----------------
# SPI1: gyro
PA5 SPI1_SCK  SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 GYRO_CS CS
# PC4 = GYRO_EXTI (gyro DRDY), not needed separately in AP

# SPI2: SD card
PB13 SPI2_SCK  SPI2
PC2  SPI2_MISO SPI2
PC3  SPI2_MOSI SPI2
PB12 SDCARD_CS CS

# SPI3: MAX7456 OSD (OSD_CS = PC14)
PB3 SPI3_SCK  SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3
PC14 OSD_CS CS

SPIDEV icm42688 SPI1 DEVID1 GYRO_CS MODE3 2*MHZ 16*MHZ
SPIDEV sdcard SPI2 DEVID1 SDCARD_CS MODE0 400*KHZ 25*MHZ
SPIDEV osd    SPI3 DEVID1 OSD_CS   MODE0 10*MHZ 10*MHZ
SPI_ORDER SPI1 SPI2 SPI3

# ---------------- IMU ----------------
# ICM42688P. Betaflight: sensor_align CW0FLIP + pitch 180 => ROTATION_PITCH_180
# ??? check on the bench
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180

# ---------------- I2C ----------------
PB8 I2C1_SCL I2C1 PULLUP
PB9 I2C1_SDA I2C1 PULLUP
I2C_ORDER I2C1


# Baro DPS310 on I2C1, address 0x76 or 0x77
#BARO DPS310 I2C:0:0x76
#BARO DPS310 I2C:0:0x77
# Baro: BF status says DPS310. Extra candidates only for diagnostics.
#BARO DPS310 I2C:0:0x76
#BARO DPS310 I2C:0:0x77
BARO SPL06 I2C:0:0x76
#BARO SPL06 I2C:0:0x77
#BARO BMP280 I2C:0:0x76
#BARO BMP280 I2C:0:0x77

# ---------------- OSD ----------------
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1     # MAX7456

# ---------------- Outputs ----------------
# Betaflight order: MOTOR1=PC8, MOTOR2=PC9, MOTOR3=PA8, MOTOR4=PA9
# BIDIR = bidirectional DShot
PC8  TIM8_CH3  TIM8  PWM(1) GPIO(50)
PC9  TIM8_CH4  TIM8  PWM(2) GPIO(51)
PA8  TIM1_CH1  TIM1  PWM(3) GPIO(52)
PA9  TIM1_CH2  TIM1  PWM(4) GPIO(53)
# SERVO1/SERVO2 from Betaflight
PB15 TIM12_CH2 TIM12 PWM(5) GPIO(54) NODMA
PB10 TIM2_CH3  TIM2  PWM(6) GPIO(55) NODMA

# ---------------- ADC ----------------
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PB1 BATT_CURRENT_SENS ADC1 SCALE(1)

define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 9
define HAL_BATT_VOLT_SCALE 22.1   # from vbat_scale = 221
define HAL_BATT_CURR_SCALE 140.8  # ??? from ibata_scale = 71, must be calibrated
define HAL_BATT_MONITOR_DEFAULT 4

# ---------------- LED / buzzer ----------------
# ??? LED is probably active-low
PB0 LED OUTPUT HIGH GPIO(90)
define HAL_GPIO_A_LED_PIN 90


# beeper_inversion = ON => active high
PB11 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80
define HAL_BUZZER_ON_LEVEL 1

# ---------------- PINIO (GPIO outputs) ----------------
# Betaflight pinio_config = 129,129,1,1: PINIO1/2 active low, PINIO3 active high
PB14 PINIO1 OUTPUT HIGH GPIO(81)  # ??? purpose unknown
PA15 PINIO2 OUTPUT HIGH GPIO(82)
PA0  PINIO3 OUTPUT LOW  GPIO(83)
# Use RELAYn_PIN = 81/82/83 to control them

# PA10 = CAMERA_CONTROL (TIM1_CH3), left unused: same timer as motors 3/4

# ---------------- SD card ----------------
define HAL_OS_FATFS_IO 1
define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"
